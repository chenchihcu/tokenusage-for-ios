{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentokenusage-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentokenusage-db",
      "database_id": "c4730902-80f1-45f8-bfdf-af234720ea05"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CATALOG",
      "id": "dde703e1cb314858be3478285c75ea57"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceSessionDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["VoiceSessionDO"]
    }
  ]
}
